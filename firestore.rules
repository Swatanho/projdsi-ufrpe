rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Médicos autenticados podem visualizar pacientes cadastrados na plataforma.
    match /{path=**}/patients/{patientId} {
      allow read: if request.auth != null;
    }

    match /patients/{patientId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.doctorId == request.auth.uid;
      // O código nunca envia `doctorId` na atualização (só os campos do
      // paciente), então basta verificar o dono no documento existente.
      // A transferência de dono é impedida porque `doctorId` não pode
      // ser alterado por esta escrita.
      allow update: if request.auth != null
        && resource.data.doctorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.doctorId == request.auth.uid;

      match /risk_assessments/{assessmentId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/patients/$(patientId))
            .data.doctorId == request.auth.uid;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/patients/$(patientId))
            .data.doctorId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'prediction',
            'riskPercentage',
            'modelName',
            'message',
            'createdAt'
          ])
          && request.resource.data.prediction in [0, 1]
          && request.resource.data.riskPercentage is number
          && request.resource.data.riskPercentage >= 0
          && request.resource.data.riskPercentage <= 100
          && request.resource.data.modelName in [
            'logistic_regression',
            'xgboost'
          ]
          && request.resource.data.message is string
          && request.resource.data.createdAt == request.time;
      }
    }

    // Perfis dos médicos: cada usuário só acessa o próprio documento.
    // A propriedade é definida pela `uid` (o documento é gravado em
    // `/doctors/{uid}`), não pelo e-mail — evita o cenário em que o e-mail
    // digitado no cadastro difere do e-mail normalizado do token.
    match /doctors/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /patients/{patientId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
